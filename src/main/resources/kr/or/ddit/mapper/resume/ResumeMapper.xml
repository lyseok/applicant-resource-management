	<select id="selectResumeList">
	  	SELECT  RESUME_NO
		      , RESUME_MAIN_YN
		      , INTRODUCTION_NO
		      , USER_ID
		      , USER_NAME
		      , PHOTO
		      , TO_CHAR(TO_DATE(BIRTH, 'YYYYMMDD'), 'YYYY-MM-DD') AS BIRTH
		      , EMAIL
		      , TEL
		      , ADDRESS
		      , VETERAN_REASON
		      , TO_CHAR(TO_DATE(UPDATE_DATE, 'YYYYMMDD'), 'YYYY-MM-DD') AS UPDATE_DATE
		      , RESUME_SUBMIT_YN
		      , RESUME_DELETE_DATE
		      , RESUME_NAME
		  FROM resume
		 WHERE USER_ID = #{userId}
		   AND RESUME_DELETE_DATE IS NULL

	</select>
	
	<select id="selectResumeDetail">
	  	SELECT  RESUME_NO
		      , RESUME_MAIN_YN
		      , INTRODUCTION_NO
		      , USER_ID
		      , USER_NAME
		      , PHOTO
		      , TO_CHAR(TO_DATE(BIRTH, 'YYYYMMDD'), 'YYYY-MM-DD') AS BIRTH
		      , EMAIL
		      , TEL
		      , ADDRESS
		      , VETERAN_REASON
		      , TO_CHAR(TO_DATE(UPDATE_DATE, 'YYYYMMDD'), 'YYYY-MM-DD') AS UPDATE_DATE
		      , RESUME_SUBMIT_YN
		      , RESUME_DELETE_DATE
		      , RESUME_NAME
		  FROM resume
		 WHERE USER_ID = #{userId}
		   AND RESUME_DELETE_DATE IS NULL
		   AND RESUME_NO = #{resumeNo}
	</select>
	
	
	<insert id="insertResume">
		<selectKey resultType="string" keyProperty="resumeNo" order="BEFORE">
		    SELECT
		        'RESM'||
		        LPAD(NVL(TO_NUMBER(SUBSTR(MAX(RESUME_NO), LENGTH('RESM' ) + 1)), 0) + 1, 6, '0')
		    FROM RESUME
		</selectKey>
		INSERT INTO RESUME (
			RESUME_NO
			, USER_ID
			, USER_NAME
			, PHOTO
			, BIRTH
			, EMAIL
			, TEL
			, ADDRESS
			, VETERAN_REASON
			, UPDATE_DATE
			, RESUME_SUBMIT_YN
			, RESUME_DELETE_DATE
		) VALUES (
			#{resumeNo}
			, #{userId}
			, #{userName}
			, #{photo}
			, REPLACE(#{birth}, '-', '')
			, #{email}
			, #{tel}
			, #{address}
			, #{veteranReason}
			, TO_CHAR(SYSDATE, 'YYYYMMDD')
			, #{resumeSubmitYn}
			, #{resumeDeleteDate}
		)
	</insert>
	<update id="updateResume">
		UPDATE RESUME 
		   SET USER_ID = #{userId}
		       , USER_NAME = #{userName}
		       , PHOTO = #{photo}
		       , BIRTH = REPLACE(#{birth}, '-', '')
		       , EMAIL = #{email}
		       , TEL = #{tel}
		       , ADDRESS = #{address}
		       , VETERAN_REASON = #{veteranReason}
		       , UPDATE_DATE = TO_CHAR(SYSDATE, 'YYYYMMDD')
		       , RESUME_SUBMIT_YN = #{resumeSubmitYn}
		       , RESUME_DELETE_DATE = #{resumeDeleteDate}
		 WHERE RESUME_NO = #{resumeNo}
	</update>
	
	<delete id="deleteResume">
		DELETE FROM RESUME
		 WHERE RESUME_NO = #{resumeNo}
	</delete>
	
	
	
	 <select id="selectResumeWithCareers" resultMap="resumeWithCareerMap">
		    SELECT
		      r.RESUME_NO,
		      r.USER_ID,
		      r.USER_NAME,
		      c.CAREER_NO,
		      c.JOB_CODE,
		      c.START_WORK_DATE,
		      c.RETIRE_DATE,
		      c.TENURE,
		      c.DEPARTMENT,
		      c.RESPONSIBILITY,
		      c.FREELANCER,
		      c.JOB_GRADE_CODE,
		      c.POSITION_CODE,
		      c.CAREER_YEAR,
		      c.SALARY,
		      c.LOCATION,
		      c.COM_ID,
		      comp.COM_NAME
		    FROM
		      RESUME r
		      LEFT JOIN CAREER c
		        ON r.RESUME_NO = c.RESUME_NO
		      LEFT JOIN COMPANY comp
		        ON c.COM_ID = comp.USER_ID
		    WHERE
		      r.USER_ID = #{userId}
		    ORDER BY
		      r.UPDATE_DATE DESC
  </select>
  
