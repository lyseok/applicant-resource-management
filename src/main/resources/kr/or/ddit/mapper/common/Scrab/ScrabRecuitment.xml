<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.or.ddit.mapper.common.scrab.ScrabRecuitment">
<insert id="insertScrabRecuitment">
	INSERT INTO SCRAB_RECUITMENT(
		USER_ID
		,RECRUITMEMT_NO
		,SCRAB_RECUITMENT_DATE
		)VALUES(
		#{userId}
		,#{recuitmentNo}
		,SYSDATE
		)
</insert>

<select id="scrabRecuitmentAll">
	SELECT *
	FROM SCRAB_RECUITMENT
	WHERE USER_ID = #{userId}
</select>

<delete id="deleteScrabRecuitment">
	DELETE FROM SCRAB_RECUITMENT
	WHERE 
	USER_ID =#{userId} 
	AND 
	RECRUITMENT_NO = ${recuitmentNo};
</delete>

</mapper>