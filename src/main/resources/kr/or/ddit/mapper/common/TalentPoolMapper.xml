	<resultMap id="resumeMap"
		type="kr.or.ddit.vo.resume.ResumeVO">
		<!-- 기본 ResumeVO 매핑 -->
		<id property="resumeNo" column="resume_no" />
		<result property="userId" column="user_id" />
		<result property="userName" column="user_name" />
		<result property="photo" column="photo" />
		<result property="birth" column="birth" />
		<result property="email" column="email" />
		<result property="tel" column="tel" />
		<result property="address" column="address" />
		<result property="veteranReason" column="veteran_reason" />
		<result property="updateDate" column="update_date" />
		<result property="resumeSubmitYn" column="resume_submit_yn" />
		<result property="resumeDeleteDate" column="resume_delete_date" />

		<!-- MemberVO 매핑 -->
		<association property="member"
			javaType="kr.or.ddit.vo.common.MemberVO">
			<result property="userId" column="user_id" />
			<result property="memName" column="mem_name" />
			<result property="memEmail" column="mem_email" />
			<result property="memBir" column="mem_bir" />
			<result property="memTel" column="mem_tel" />
			<result property="memAdd1" column="mem_add1" />
			<result property="memAdd2" column="mem_add2" />
			<result property="memImg" column="mem_img" />
		</association>

		<!-- MySkillVO 리스트 매핑 -->
		<collection property="mySkillList"
			ofType="kr.or.ddit.vo.resume.MySkillVO">
			<id property="mySkillCode" column="my_skill_code" />
			<result property="resumeNo" column="resume_no" />
			<result property="mySkillName" column="my_skill_name" />
			<result property="deleteDate" column="delete_date" />
		</collection>
		
		<!-- careerVO 매핑 -->
		<collection property="careerList" ofType="CareerVO">
    <id property="careerNo" column="career_no"/>
    <result property="resumeNo" column="resume_no"/>
    <result property="jobCode" column="job_code"/>
    <result property="startWorkDate" column="start_work_date"/>
    <result property="retireDate" column="retire_date"/>
    <result property="tenure" column="tenure"/>
    <result property="department" column="department"/>
    <result property="responsibility" column="responsibility"/>
    <result property="freelancer" column="freelancer"/>
    <result property="jobGradeCode" column="job_grade_code"/>
    <result property="positionCode" column="position_code"/>
    <result property="careerYear" column="career_year"/>
    <result property="salary" column="salary"/>
    <result property="location" column="location"/>
    <result property="deleteDate" column="delete_date"/>
    <result property="comId" column="com_id"/>
		</collection>
		
		<!-- myLicenseList 매핑 -->
		<collection property="myLicenseList" ofType="MyLicenseVO">
    <id property="myLicense" column="my_license"/>
    <result property="resumeNo" column="resume_no"/>
    <result property="licenseCode" column="license_code"/>
    <result property="licensePassDate" column="license_pass_date"/>
    <result property="deleteDate" column="delete_date"/>
</collection>
	</resultMap>

	<select id="selectResumeDetail" resultMap="resumeMap">
		select
		*
		from resume r, member m, my_skill s, career c
		where r.user_id = m.user_id
		and r.resume_no = s.resume_no
        and r.resume_no = c.resume_no
		and r.user_id = #{userId}
		and r.resume_main_yn = 'Y'

	</select>

