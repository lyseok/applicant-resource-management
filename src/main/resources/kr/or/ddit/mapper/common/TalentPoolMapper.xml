	<select id="selectSearchSkillAndLicense"
		resultMap="resumeResultMap" parameterType="map">
		SELECT
		A.RESUME_NO,
		A.USER_NAME,
		A.USER_ID,
		A.EMAIL,
		A.ADDRESS,
		B.JOB_CODE,
		B.START_WORK_DATE,
		B.RETIRE_DATE,
		B.RESPONSIBILITY,
		B.CAREER_YEAR,
		B.SALARY,
		B.LOCATION,
		C.MY_SKILL_NAME,
		L.MY_LICENSE
		FROM RESUME A
		LEFT JOIN CAREER B ON A.RESUME_NO = B.RESUME_NO
		LEFT JOIN MY_SKILL C ON A.RESUME_NO = C.RESUME_NO
		LEFT JOIN MY_LICENSE L ON A.RESUME_NO = L.RESUME_NO
		<where>
			<if test="skillName != null and skillName != ''">
				AND C.MY_SKILL_NAME LIKE '%' || #{skillName} || '%'
			</if>
			<if test="keywordlicense != null and keywordlicense != ''">
				AND L.MY_LICENSE LIKE '%' || #{license} || '%'
			</if>
		</where>
		ORDER BY A.USER_NAME
	</select>

