	<select id="selectTalentPoolList" resultMap="resumeResultMap">
		SELECT
		A.RESUME_NO,
		A.USER_NAME,
		A.USER_ID,
		A.EMAIL,
		A.ADDRESS,
		B.JOB_CODE,
		B.START_WORK_DATE,
		B.RETIRE_DATE,
		B.RESPONSIBILITY,
		B.CAREER_YEAR,
		B.SALARY,
		B.LOCATION,
		C.MY_SKILL_NAME,
		D.JOB_CODE AS JOB_CODE,
		D.TOP_JOB_CODE,
		D.JOB_NAME
		FROM RESUME A
		LEFT JOIN CAREER B ON A.RESUME_NO = B.RESUME_NO
		LEFT JOIN MY_SKILL C ON A.RESUME_NO = C.RESUME_NO
		LEFT JOIN JOB D ON B.JOB_CODE = D.JOB_CODE
		ORDER BY A.USER_NAME
	</select>


