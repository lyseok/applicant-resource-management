	<select id="selectMember" parameterType="string"
		resultType="MemberVO">
		SELECT
		MEM_ID
		, MEM_PASSWORD
		, MEM_NAME
		, MEM_REGNO1
		,
		MEM_REGNO2
		, MEM_BIR
		, MEM_ZIP
		, MEM_ADD1
		, MEM_ADD2
		, MEM_HOMETEL
		,
		MEM_COMTEL
		, MEM_HP
		, MEM_MAIL
		, MEM_JOB
		, MEM_HOPPY
		, MEM_MEMORIAL
		,
		MEM_MEMORIALDAY
		, MEM_MILEAGE
		, MEM_DELETE
		, MEM_ROLE
		FROM MEMBER
		WHERE
		MEM_ID = #{username}
	</select>

	<insert id="insertMember">
		INSERT INTO MEMBER(
		MEM_ID
		,MEM_PASSWORD
		,MEM_NAME
		,MEM_REGNO1
		,MEM_REGNO2
		,MEM_BIR
		,MEM_ZIP
		,MEM_ADD1
		,MEM_ADD2
		,MEM_HOMETEL
		,MEM_COMTEL
		,MEM_HP
		,MEM_MAIL
		,MEM_JOB
		,MEM_HOPPY
		,MEM_MEMORIAL
		,MEM_MEMORIALDAY
		)VALUES(
		#{memId},
		#{memPassword},
		#{memName},
		#{memRegno1},
		#{memRegno2},
		#{memBir},
		#{memZip},
		#{memAdd1},
		#{memAdd2},
		#{memHometel},
		#{memComtel},
		#{memHp},
		#{memMail},
		#{memJob},
		#{memHoppy},
		#{memMemorial},
		#{memMemorialday}
		)
	</insert>
	<select id="selectMemberByMail" parameterType="string"
		resultType="MemberVO">
		SELECT
		MEM_ID
		, MEM_PASSWORD
		, MEM_NAME
		, MEM_REGNO1
		,
		MEM_REGNO2
		, MEM_BIR
		, MEM_ZIP
		, MEM_ADD1
		, MEM_ADD2
		, MEM_HOMETEL
		,
		MEM_COMTEL
		, MEM_HP
		, MEM_MAIL
		, MEM_JOB
		, MEM_HOPPY
		, MEM_MEMORIAL
		,
		MEM_MEMORIALDAY
		, MEM_MILEAGE
		, MEM_DELETE
		, MEM_ROLE
		FROM MEMBER
		WHERE
		MEM_MAIL = #{mail}
	</select>

	<update id="updateMemDelete">
		UPDATE MEMBER
		SET MEM_DELETE= 'T'
		WHERE MEM_ID =
		#{memId}
	</update>

	<update id="updateMember">
		UPDATE MEMBER
		SET MEM_NAME =#{memName}
		,MEM_REGNO1
		=#{memRegno1}
		,MEM_REGNO2
		=#{memRegno2}
		,MEM_BIR =#{memBir}
		,MEM_ZIP
		=#{memZip}
		,MEM_ADD1
		=#{memAdd1}
		,MEM_ADD2 =#{memAdd2}
		,MEM_HOMETEL
		=#{memHometel}
		,MEM_COMTEL =#{memComtel}
		,MEM_HP =#{memHp}
		,MEM_MAIL
		=#{memMail}
		,MEM_JOB =#{memJob}
		,MEM_HOPPY =#{memHoppy}
		,MEM_MEMORIAL
		=#{memMemorial}
		,MEM_MEMORIALDAY=#{memMemorialday}
		WHERE MEM_ID =
		#{memId}
	</update>

