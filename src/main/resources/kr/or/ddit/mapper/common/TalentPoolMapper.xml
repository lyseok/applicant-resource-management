	<select id="selectResumeDetail" resultMap="resumeMap">
		select
		*
		from resume r,
		member m, my_skill s, career c
		where r.user_id = m.user_id
		and
		r.resume_no = s.resume_no
		and r.resume_no = c.resume_no
		and r.user_id =
		#{userId}
		and
		r.RESUME_SUBMIT_YN = 'Y'

	</select>

