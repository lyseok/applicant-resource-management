	<!-- 2. select 문 분리 -->
	<select id="selectTalentPoolListByFilter"
		resultMap="resumeResultMap">
		SELECT
		R.RESUME_NO,
		R.USER_ID,
		R.USER_NAME,
		R.ADDRESS,
		R.UPDATE_DATE,
		R.EMAIL,
		C.CAREER_YEAR,
		J.JOB_CODE,
		J.JOB_NAME,
		J.TOP_JOB_CODE,
		TJ.TOP_JOB_NAME,
		C.SALARY,
		E.HIGHEST_EDUCATION_CODE,
		E.GRADUATE_YN
		FROM
		RESUME R
		LEFT JOIN CAREER C ON R.RESUME_NO = C.RESUME_NO
		LEFT JOIN JOB J
		ON C.JOB_CODE = J.JOB_CODE
		LEFT JOIN TOP_JOB TJ ON J.TOP_JOB_CODE =
		TJ.TOP_JOB_CODE
		LEFT JOIN EDUCATION E ON R.RESUME_NO = E.RESUME_NO
		<where>
			R.RESUME_MAIN_YN = 'Y'

			<!-- 경력 필터 -->
			<if test="careerlong != null and careerlong != ''">
				AND C.CAREER_YEAR &gt;= #{careerlong}
			</if>

			<!-- 지역 필터 -->
			<if test="location != null and location != ''">
				AND R.ADDRESS LIKE '%' || #{location} || '%'
			</if>

			<!-- 최종학력 필터 -->
			<if test="edudone != null and edudone != ''">
				AND E.HIGHEST_EDUCATION_CODE = #{edudone}
			</if>

			<!-- 졸업여부 필터 -->
			<if test="gedu != null and gedu != ''">
				AND E.GRADUATE_YN = #{gedu}
			</if>

			<!-- 직군 필터 -->
			<if test="topJob != null and topJob != ''">
				AND TJ.TOP_JOB_NAME = #{topJob}
			</if>

			<!-- 직무 필터 -->
			<if test="job != null and job != ''">
				AND J.JOB_CODE = #{job}
			</if>
		</where>
		ORDER BY R.UPDATE_DATE DESC
	</select>


