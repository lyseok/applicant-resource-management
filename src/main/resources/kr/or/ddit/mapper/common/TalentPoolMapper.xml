<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.or.ddit.mapper.common.TalentPoolMapper">
	
	
	
	<select id="selectlocation" resultType="CityCodeVO">
		SELECT CITY_NAME
		FROM CITY_CODE
	</select>

	<select id="selecteducation" resultType="EducationVO">
		SELECT 
   			 HIGHEST_EDUCATION_CODE
    		, GRADUATE_YN
		FROM 
    		EDUCATION
	</select>
	
	
	<select id="selectTopJob" resultType="TopJobVO">
		SELECT *
		FROM TOP_JOB
	</select>
	
	<select id="selectJob" resultType="JobVO">
		SELECT *
		FROM JOB
		<!-- WHERE = #{tobJob} -->
	</select>

	<select id="selectTalentPoolList" resultType="resumeVO">
		SELECT
		A.USER_NAME,
		A.USER_ID,
		B.JOB_CODE,
		B.START_WORK_DATE,
		B.RETIRE_DATE,
		B.TENURE,
		B.RESPONSIBILITY,
		B.FREELANCER,
		B.JOB_GRADE_CODE,
		B.POSITION_CODE,
		B.CAREER_YEAR,
		B.SALARY,
		B.LOCATION,
		LISTAGG(C.MY_SKILL_NAME, ', ') WITHIN GROUP (ORDER BY
		C.MY_SKILL_NAME) AS SKILLS
		FROM
		RESUME A
		INNER JOIN
		CAREER B ON
		A.RESUME_NO = B.RESUME_NO
		LEFT JOIN
		MY_SKILL C ON A.RESUME_NO =
		C.RESUME_NO

		GROUP BY
		A.USER_NAME,
		A.USER_ID,
		B.JOB_CODE,
		B.START_WORK_DATE,
		B.RETIRE_DATE,
		B.TENURE,
		B.RESPONSIBILITY,
		B.FREELANCER,
		B.JOB_GRADE_CODE,
		B.POSITION_CODE,
		B.CAREER_YEAR,
		B.SALARY,
		B.LOCATION,
		A.RESUME_NO
		ORDER BY
		A.USER_NAME
	</select>

