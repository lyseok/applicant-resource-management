<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.or.ddit.mapper.common.scrab.ScrabRecuitment">
<insert id="insertScrabRecuitment">
	INSERT INTO SCRAB_RECUITMENT(
		USER_ID
		,RECRUITMEMT_NO
		,SCRAB_RECUITMENT_DATE
		)VALUES(
		#{USER_ID}
		,#{RECUITMENT_NO}
		,TO_CHAR(SYSDATE,'YYYY/MM/DD')
		)
</insert>

<select id="ScrabRecuitmentAll" >
	SELECT *
	FROM SCRAB_RECUITMENT
	WHERE USER_ID = #{user_id}
</select>
</mapper>