<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<html>
<head>
  <meta charset="UTF-8">
  <title>직책별 연봉 상세조회</title>
 
</head>

<body class="bg-light">
  <div class="container mt-5">
    <h2 class="text-center mb-4">직책별 연봉 상세조회</h2>

    <div class="card shadow-sm p-4 bg-white">
      <table class="table table-bordered text-center align-middle">
        <thead class="table-light">
          <tr>
            <th>직책</th>
            <th>최소 연봉 (원)</th>
            <th>최대 연봉 (원)</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>사원</td><td>30,000,000 원</td><td>40,000,000 원</td></tr>
          <tr><td>주임</td><td>40,000,000 원</td><td>50,000,000 원</td></tr>
          <tr><td>대리</td><td>50,000,000 원</td><td>60,000,000 원</td></tr>
          <tr><td>과장</td><td>60,000,000 원</td><td>70,000,000 원</td></tr>
          <tr><td>차장</td><td>70,000,000 원</td><td>80,000,000 원</td></tr>
          <tr><td>부장</td><td>80,000,000 원</td><td>90,000,000 원</td></tr>
          <tr><td>이사</td><td>90,000,000 원</td><td>100,000,000 원</td></tr>
          <tr><td>상무</td><td>100,000,000 원</td><td>110,000,000 원</td></tr>
          <tr><td>전무</td><td>110,000,000 원</td><td>120,000,000 원</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>
