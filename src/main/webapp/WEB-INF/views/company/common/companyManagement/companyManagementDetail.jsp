<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>기업 정보 관리</title>
  <link rel="stylesheet" href="/css/member/resume/resume.css" >

</head>
<body>
  

  <div class="company-info-wrap">
    <!-- Header Section -->
    <div class="company-header">
      <p class="h2">기업 정보 관리</p>
    </div>

    <!-- 기업명 (Company Name) -->
    <div class="section">
      <div class="section-title">기업명</div>
      <div class="section-content" id="com_name">기업명 데이터</div>
    </div>

    <!-- 기업설명 (Company Description) -->
    <div class="section">
      <div class="section-title">기업설명</div>
      <div class="section-content" id="com_info">기업설명 데이터</div>
    </div>

    <!-- 대표번호 (Phone Number) -->
    <div class="section">
      <div class="section-title">대표번호</div>
      <div class="section-content" id="com_num">대표번호 데이터</div>
    </div>

    <!-- 이메일 (Email) -->
    <div class="section">
      <div class="section-title">이메일</div>
      <div class="section-content" id="com_email">이메일 데이터</div>
    </div>

    <!-- 홈페이지 URL (Website URL) -->
    <div class="section">
      <div class="section-title">홈페이지 URL</div>
      <div class="section-content" id="com_url"><a href="#">홈페이지 링크</a></div>
    </div>

    <!-- 설립년도 (Year of Establishment) -->
    <div class="section">
      <div class="section-title">설립년도</div>
      <div class="section-content" id="com_create_year">설립년도 데이터</div>
    </div>

    <!-- 직원수 (Number of Employees) -->
    <div class="section">
      <div class="section-title">직원수</div>
      <div class="section-content" id="com_mem">직원수 데이터</div>
    </div>

    <!-- 기업로고 (Company Logo) -->
    <div class="section">
      <div class="section-title">기업로고</div>
      <div class="section-content" id="com_logo">
        <img src="logo_placeholder.png" alt="Company Logo" style="width: 100px; height: auto;">
      </div>
    </div>

    <!-- 구독여부 (Subscription Status) -->
    <div class="section">
      <div class="section-title">구독여부</div>
      <div class="section-content" id="com_payment">구독여부 데이터</div>
    </div>

    <!-- 업종 코드 (Industry Type) -->
    <div class="section">
      <div class="section-title">업종 코드</div>
      <div class="section-content" id="industry_type">업종 코드 데이터</div>
    </div>

  </div>
 
</body>
</html>
